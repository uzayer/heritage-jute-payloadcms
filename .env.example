# Local development uses this disposable SQLite database. It is never deployed.
DATABASE_URL=file:./heritage-jute-development.db
# Leave blank for a local file. Turso development, preview, and production use their own token.
DATABASE_AUTH_TOKEN=

# The full Product importer reads the current Astro reference from this directory.
# Defaults to a sibling directory named heritage-jute when left blank.
HERITAGE_JUTE_SOURCE_DIR=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 is optional locally. On Vercel, set every R2 variable below.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.example.com

# Resend API key and verified sender that deliver the contact page's inquiry
# submissions. RESEND_FROM_EMAIL must be an address on a domain verified in Resend;
# the inquiry is sent to the Company global's email field.
RESEND_API_KEY=YOUR_SECRET_HERE
RESEND_FROM_EMAIL=YOUR_VERIFIED_SENDER_HERE
